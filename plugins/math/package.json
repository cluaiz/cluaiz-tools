  "functions": [
    {
      "name": "math_evaluate",
      "description": "Evaluate a math expression. Supports + - * / % ^, parentheses, pi, e, sqrt, cbrt, abs, floor, ceil, round, sin, cos, tan, asin, acos, atan (radians), ln, log10, log2 and exp. Numbers are 64-bit floats, about 15 significant digits.",
      "parameters": {
        "type": "object",
        "properties": {
          "expression": {
            "type": "string",
            "description": "The expression, for example 'sqrt(144) * 25' or 'sin(pi / 4)'"
          },
          "precision": {
            "type": "integer",
            "description": "Digits after the decimal point in 'formatted'"
          }
        },
        "required": [
          "expression"
        ]
      }
    }
  ],
