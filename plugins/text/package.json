  "functions": [
    {
      "name": "text_transform",
      "description": "Exact text work. action is one of: sha256, base64_encode, base64_decode, stats (characters, words, lines, bytes), diff (compares input with target, line by line), extract (every match of a regular expression in pattern).",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "sha256",
              "base64_encode",
              "base64_decode",
              "stats",
              "diff",
              "extract"
            ],
            "description": "What to do"
          },
          "input": {
            "type": "string",
            "description": "The text"
          },
          "pattern": {
            "type": "string",
            "description": "For extract: a regular expression"
          },
          "target": {
            "type": "string",
            "description": "For diff: the text to compare with"
          }
        },
        "required": [
          "action",
          "input"
        ]
      }
    }
  ],
