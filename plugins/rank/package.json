{
  "id": "rank",
  "name": "Rank",
  "category": "utility",
  "hub_type": "plugin",
  "build_type": "wasm",
  "description": "Ranks texts passed to it by how well they match a keyword query. It cannot read files or the web. Use when several texts are already at hand and the best matches are needed.",
  "author": {
    "name": "Cluaiz",
    "url": "https://github.com/cluaiz"
  },
  "license": "Apache-2.0",
  "icon": "assets/icon.svg",
  "tags": [
    "Ranking",
    "Documents",
    "Search",
    "WASM"
  ],
  "triggers": [
    "rank these documents",
    "find the best match in these texts",
    "search these documents"
  ],
  "dependencies": {
    "plugins": {},
    "mcp": {},
    "skills": {}
  },
  "permissions": {},
  "functions": [
    {
      "name": "rank_documents",
      "description": "Rank the documents you pass in by how well they match a query, and return the best with snippets. It cannot read files: use the search tool for those, or web_search for the web.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Words to look for"
          },
          "documents": {
            "type": "array",
            "description": "The documents to rank",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title",
                "content"
              ]
            }
          },
          "limit": {
            "type": "integer",
            "description": "Most results to return. Default 5"
          }
        },
        "required": [
          "query",
          "documents"
        ]
      }
    }
  ],
  "latest_version": "1.0.0",
  "versions": {
    "1.0.0": {
      "updated_at": "2026-11-09T10:15:26Z",
      "builds_os": [
        "wasm"
      ],
      "files": {
        "readme": "README.md",
        "skill": "SKILL.md",
        "icon": "assets/icon.svg"
      }
    }
  }
}
