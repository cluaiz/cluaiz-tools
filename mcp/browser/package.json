{
  "id": "browser",
  "name": "Browser",
  "category": "mcp",
  "hub_type": "mcp",
  "description": "Opens web pages in a real browser, reads them, clicks and types, and tests a website: console errors, failed requests and accessibility. Needs Node.",
  "author": {
    "name": "Vercel Labs",
    "url": "https://github.com/vercel-labs/agent-browser"
  },
  "license": "Apache-2.0",
  "tags": [
    "Browser",
    "Web",
    "Testing"
  ],
  "triggers": [
    "open this website",
    "use the browser",
    "click on the page",
    "fill this form",
    "test my website",
    "take a screenshot of the page",
    "open localhost",
    "find errors on my site",
    "check console errors",
    "accessibility check"
  ],
  "dependencies": {
    "plugins": {},
    "mcp": {},
    "skills": {}
  },
  "expose": {
    "agent_browser_open": [
      "url",
      "headed"
    ],
    "agent_browser_snapshot": [
      "interactive",
      "compact"
    ],
    "agent_browser_read": [],
    "agent_browser_click": [
      "selector"
    ],
    "agent_browser_fill": [
      "selector",
      "text"
    ],
    "agent_browser_press": [
      "key"
    ],
    "agent_browser_select": [
      "selector",
      "values"
    ],
    "agent_browser_scroll": [
      "direction",
      "amount"
    ],
    "agent_browser_wait_for_text": [
      "text"
    ],
    "agent_browser_get_text": [
      "selector"
    ],
    "agent_browser_get_url": [],
    "agent_browser_screenshot": [
      "path",
      "fullPage"
    ],
    "agent_browser_back": [],
    "agent_browser_close": [],
    "agent_browser_console": [
      "clear"
    ],
    "agent_browser_errors": [
      "clear"
    ],
    "agent_browser_network_requests": [
      "filter",
      "status",
      "method",
      "type",
      "clear"
    ],
    "agent_browser_a11y": [
      "selector",
      "tags"
    ]
  },
  "user_env": [
    "AGENT_BROWSER_HEADED"
  ],
  "execution": {
    "command": "npx",
    "args": [
      "-y",
      "agent-browser@0.41.2",
      "mcp",
      "--tools",
      "core,debug,network"
    ],
    "env": {
      "AGENT_BROWSER_CONTENT_BOUNDARIES": "1",
      "AGENT_BROWSER_MAX_OUTPUT": "20000",
      "AGENT_BROWSER_IDLE_TIMEOUT_MS": "300000"
    }
  },
  "latest_version": "1.1.0",
  "versions": {
    "1.1.0": {
      "updated_at": "2026-11-07T19:00:00Z",
