{
  "id": "fetch",
  "name": "Web Fetch",
  "category": "mcp",
  "hub_type": "mcp",
  "description": "Fetches a web page and returns it as Markdown. Needs uv. Use to read one page whose address is known.",
  "author": {
    "name": "MCP Steering Group",
    "url": "https://modelcontextprotocol.io"
  },
  "license": "MIT",
  "icon": "assets/icon.svg",
  "tags": [
    "Web",
    "Fetch"
  ],
  "triggers": [
    "fetch this page",
    "download web page",
    "read this url as markdown"
  ],
  "dependencies": {
    "plugins": {},
    "mcp": {},
    "skills": {}
  },
  "permissions": {
    "network": {
      "info": "Fetches the pages that are chosen, including local addresses",
      "allow": true,
      "access": "full"
    }
  },
  "expose": {
    "fetch": [
      "url",
      "max_length",
      "start_index",
      "raw"
    ]
  },
  "execution": {
    "command": "uvx",
    "args": [
      "mcp-server-fetch@2026.11.4"
    ]
  },
