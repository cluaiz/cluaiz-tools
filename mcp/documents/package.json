{
  "id": "documents",
  "name": "Documents",
  "category": "mcp",
  "hub_type": "mcp",
  "description": "Reads PDF, Word, Excel, PowerPoint, HTML, CSV and other files as text, so the model can answer from them. Runs on this computer. Needs uv. Use when the user asks about what a document file says.",
  "author": {
    "name": "Microsoft",
    "url": "https://github.com/microsoft/markitdown"
  },
  "license": "MIT",
  "icon": "assets/icon.svg",
  "tags": [
    "Documents",
    "PDF",
    "Office"
  ],
  "triggers": [
    "read this pdf",
    "summarize this document",
    "summarize",
    "document",
    "read",
    "pdf",
    "docx",
    "xlsx",
    "pptx",
    "csv",
    "epub",
    "word document",
    "excel file",
    "powerpoint",
    "spreadsheet",
    "convert",
    "convert to markdown"
  ],
  "dependencies": {
    "plugins": {},
    "mcp": {},
    "skills": {}
  },
  "permissions": {
    "files": {
      "info": "Reads the document files it is given, anywhere your account can read",
      "allow": false,
      "can": [
        "read"
      ],
      "where": "any"
    },
    "network": {
      "info": "Reads web pages given as an http or https address",
      "allow": true,
      "access": "full"
    }
  },
  "expose": {
    "convert_to_markdown": [
      "uri"
    ]
  },
  "execution": {
    "command": "uvx",
    "args": [
      "markitdown-mcp@0.0.1a8"
    ]
  },
  "latest_version": "1.0.0",
  "versions": {
    "1.0.0": {
      "updated_at": "2026-11-09T10:15:26Z",
      "command": "uvx",
      "args": [
        "markitdown-mcp@0.0.1a8"
      ],
      "files": {
        "readme": "README.md",
        "icon": "assets/icon.svg",
        "skill": "SKILL.md"
      }
    }
  }
}
