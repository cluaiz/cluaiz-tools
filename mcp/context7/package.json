{
  "id": "context7",
  "name": "Context7 Docs",
  "category": "mcp",
  "hub_type": "mcp",
  "description": "Looks up current documentation for programming libraries. Needs Node and internet access. Use when an answer depends on how a library or framework works today.",
  "author": {
    "name": "Upstash",
    "url": "https://github.com/upstash/context7"
  },
  "license": "MIT",
  "icon": "assets/icon.svg",
  "tags": [
    "Documentation",
    "Libraries"
  ],
  "triggers": [
    "library documentation",
    "latest api docs",
    "how do i use this library",
    "context7",
    "documentation",
    "library docs",
    "framework docs"
  ],
  "dependencies": {
    "plugins": {},
    "mcp": {},
    "skills": {}
  },
  "permissions": {
    "network": {
      "info": "Sends library names and questions to the Context7 service",
      "allow": true,
      "access": "strict",
      "hosts": [
        "context7.com"
      ]
    }
  },
  "env": {
    "CONTEXT7_API_KEY": {
      "info": "A free Context7 key, for a higher rate limit",
      "need": "optional"
    }
  },
  "execution": {
    "command": "npx",
    "args": [
      "-y",
      "@upstash/context7-mcp@4.5.1"
    ]
  },
  "latest_version": "1.0.0",
  "versions": {
    "1.0.0": {
      "updated_at": "2026-11-09T10:15:26Z",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@4.5.1"
      ],
      "files": {
        "readme": "README.md",
        "icon": "assets/icon.svg",
        "skill": "SKILL.md"
      }
    }
  }
}
