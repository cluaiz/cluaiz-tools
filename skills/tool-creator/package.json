{
  "id": "tool-creator",
  "name": "Autonomous Tool Creator",
  "category": "engineering",
  "hub_type": "skill",
  "description": "Autonomous tool scaffolding and validation engine for Skills, WASM Plugins, and MCP Servers.",
  "author": {
    "name": "Aryan",
    "url": "https://github.com/cluaiz"
  },
  "license": "Apache-2.0",
  "tags": ["Scaffold", "Tool Foundry", "Code Generation", "Protocol"],
  "triggers": {
    "semantic": [
      "create plugin", "build mcp", "create skill", "new tool",
      "scaffold tool", "tool foundry", "generate tool", "build tool",
      "tool creator", "create tool", "make tool", "tool maker"
    ]
  },
  "dependencies": {
    "plugins": {},
    "mcp": {},
    "skills": {}
  },
  "execution": {
    "type": "script_runner",
    "scratch_dir": "scratch",
    "default_language": "python",
    "command": "python \"{tool_dir}/scripts/scaffold.py\" \"{file}\""
  },
  "functions": [
    {
      "name": "create_tool",
      "description": "Autonomously scaffolds and creates a new Skill, Plugin, or MCP Server in the Cluaiz ecosystem and registers it in tools registry.",
      "parameters": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": ["skills", "plugins", "mcp"],
            "description": "Pillar category for the tool"
          },
          "tool_id": {
            "type": "string",
            "description": "Unique kebab-case slug for the tool"
          },
          "name": {
            "type": "string",
            "description": "Human-readable name for the tool"
          },
          "description": {
            "type": "string",
            "description": "Accurate summary of capabilities"
          },
          "triggers": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Semantic keyword phrases that activate the tool"
          }
        },
        "required": ["category", "tool_id", "name", "description"]
      }
    }
  ],
  "latest_version": "1.0.0",
  "versions": {
    "1.0.0": {
      "updated_at": "2026-09-24T12:00:00Z",
      "files": {
        "skill": "SKILL.md",
        "icon": "assets/icon.svg",
        "scripts": ["scripts/scaffold.py"]
      }
    }
  }
}
