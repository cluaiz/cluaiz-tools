{
  "id": "tool-creator",
  "name": "Autonomous Tool Creator",
  "category": "engineering",
  "hub_type": "skill",
  "icon": "assets/icon.svg",
  "description": "Creates new skills, WebAssembly plugins and MCP packages for Cluaiz with correct manifests and registry entries, and checks a tool package for problems. Use when the user wants a new tool or asks whether a tool package is correct.",
  "author": {
    "name": "Aryan",
    "url": "https://github.com/cluaiz"
  },
  "license": "Apache-2.0",
  "tags": [
    "Scaffold",
    "Developer Tools",
    "Validation"
  ],
  "triggers": {
    "semantic": [
      "create plugin",
      "create skill",
      "create mcp",
      "build mcp",
      "new tool",
      "scaffold tool",
      "create tool",
      "build a plugin",
      "plugin",
      "skill",
      "mcp server",
      "create a tool",
      "new plugin",
      "new skill",
      "make a plugin",
      "validate tool",
      "check my tool",
      "validate skill"
    ]
  },
  "dependencies": {
    "plugins": {},
    "mcp": {},
    "skills": {}
  },
  "permissions": {
    "files": {
      "info": "Reads a tool package to check it, and creates the files of a new one",
      "allow": false,
      "can": [
        "create",
        "read",
        "update"
      ],
      "where": "workspace"
    }
  },
  "execution": {
    "type": "script_runner",
    "scratch_dir": "scratch",
    "default_language": "python",
    "command": "{python} \"{tool_dir}/scripts/scaffold.py\" \"{file}\""
  },
  "functions": [
    {
      "name": "create_tool",
      "description": "Create a new skill, WebAssembly plugin or MCP package with its manifest and registry entry.",
      "parameters": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "skills",
              "plugins",
              "mcp"
            ],
            "description": "Pillar category for the tool"
          },
          "tool_id": {
            "type": "string",
            "description": "Lowercase words joined by hyphens, such as my-tool"
          },
          "name": {
            "type": "string",
            "description": "Human-readable name for the tool"
          },
          "description": {
            "type": "string",
            "description": "What it does and when to use it"
          },
          "triggers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Short phrases a user would say when they need this tool"
          },
          "skill_instructions": {
            "type": "string",
            "description": "For a skill or plugin: the body of SKILL.md"
          },
          "command": {
            "type": "string",
            "description": "For mcp: the program that starts the server, such as npx or uvx"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "For mcp: its arguments"
          },
          "overwrite": {
            "type": "boolean",
            "description": "Replace a tool that already exists"
          }
        },
        "required": [
          "category",
          "tool_id",
          "name",
          "description"
        ]
      }
    },
    {
      "name": "validate_tool",
      "description": "Check a Cluaiz tool package (skill, plugin, MCP) is valid and ready to publish; returns errors and warnings.",
      "parameters": {
        "type": "object",
        "properties": {
          "tool_id": {
            "type": "string",
            "description": "The tool's id"
          },
          "path": {
            "type": "string",
            "description": "Or the tool's folder"
          }
        },
        "required": []
      }
    }
  ],
  "latest_version": "1.0.0",
  "versions": {
    "1.0.0": {
      "updated_at": "2026-11-11T09:12:00Z",
      "files": {
        "readme": "README.md",
        "skill": "SKILL.md",
        "icon": "assets/icon.svg",
        "references": [
          "references/mcp-server-authoring.md",
          "references/skill-authoring.md",
          "references/validation-rubric.md",
          "references/wasm-plugin-authoring.md",
          "references/workflow-and-flow-authoring.md"
        ],
        "scripts": [
          "scripts/scaffold.py",
          "scripts/validate.py"
        ]
      }
    }
  }
}
