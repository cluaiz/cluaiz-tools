{
  "id": "tool-creator",
  "name": "Autonomous Tool Creator",
  "category": "engineering",
  "hub_type": "skill",
  "description": "Creates new skills, WebAssembly plugins and MCP packages for Cluaiz, with correct manifests and registry entries.",
  "author": {
    "name": "Aryan",
    "url": "https://github.com/cluaiz"
  },
  "license": "Apache-2.0",
  "tags": [
    "Scaffold",
    "Developer Tools"
  ],
  "triggers": {
    "semantic": [
      "create plugin",
      "create skill",
      "create mcp",
      "build mcp",
      "new tool",
      "scaffold tool",
      "create tool",
      "build a plugin"
    ]
  },
  "dependencies": {
    "plugins": {},
    "mcp": {},
    "skills": {}
  },
  "execution": {
    "type": "script_runner",
    "scratch_dir": "scratch",
    "default_language": "python",
    "command": "{python} \"{tool_dir}/scripts/scaffold.py\" \"{file}\""
  },
  "functions": [
    {
      "name": "create_tool",
      "description": "Create a new skill, WebAssembly plugin or MCP package, installed on this computer and added to the cluaiz-tools repository if that is the open folder.",
      "parameters": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "skills",
              "plugins",
              "mcp"
            ],
            "description": "Pillar category for the tool"
          },
          "tool_id": {
            "type": "string",
            "description": "Lowercase words joined by hyphens, such as my-tool"
          },
          "name": {
            "type": "string",
            "description": "Human-readable name for the tool"
          },
          "description": {
            "type": "string",
            "description": "What it does and when to use it"
          },
          "triggers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Short phrases a user would say when they need this tool"
          },
          "skill_instructions": {
            "type": "string",
            "description": "For a skill or plugin: the body of SKILL.md"
          },
          "command": {
            "type": "string",
            "description": "For mcp: the program that starts the server, such as npx or uvx"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "For mcp: its arguments"
          },
          "overwrite": {
            "type": "boolean",
            "description": "Replace a tool that already exists"
          }
        },
        "required": [
          "category",
          "tool_id",
          "name",
          "description"
        ]
      }
    }
  ],
  "latest_version": "1.0.1",
  "versions": {
    "1.0.1": {
      "updated_at": "2026-11-07T12:00:00Z",
      "files": {
        "skill": "SKILL.md",
        "icon": "assets/icon.svg",
        "scripts": [
          "scripts/scaffold.py"
        ]
      }
    }
  }
}
