{
  "id": "code-interpreter",
  "name": "Code Interpreter",
  "category": "engineering",
  "hub_type": "skill",
  "icon": "assets/icon.svg",
  "description": "Runs code on this computer and returns its real output: calculations, data files, statistics, charts, and checking that code works. Use whenever an answer should come from running code rather than guessing.",
  "author": {
    "name": "Aryan",
    "url": "https://github.com/cluaiz"
  },
  "license": "Apache-2.0",
  "security_mode": "sandboxed",
  "triggers": {
    "semantic": [
      "run this code",
      "execute code",
      "run python",
      "execute python",
      "run javascript",
      "run node",
      "run script",
      "code interpreter",
      "code runner",
      "analyze this csv",
      "make a chart",
      "analyze data file"
    ]
  },
  "dependencies": {
    "plugins": {},
    "mcp": {},
    "skills": {}
  },
  "execution": {
    "type": "script_runner",
    "scratch_dir": "scratch",
    "default_language": "python",
    "languages": {
      "python": {
        "cmd": "{python} \"{file}\"",
        "ext": "py"
      },
      "py": {
        "cmd": "{python} \"{file}\"",
        "ext": "py"
      },
      "javascript": {
        "cmd": "node \"{file}\"",
        "ext": "js"
      },
      "js": {
        "cmd": "node \"{file}\"",
        "ext": "js"
      },
      "node": {
        "cmd": "node \"{file}\"",
        "ext": "js"
      },
      "typescript": {
        "cmd": "npx ts-node \"{file}\"",
        "ext": "ts"
      },
      "ts": {
        "cmd": "npx ts-node \"{file}\"",
        "ext": "ts"
      },
      "powershell": {
        "cmd": "powershell -File \"{file}\"",
        "ext": "ps1"
      },
      "ps1": {
        "cmd": "powershell -File \"{file}\"",
        "ext": "ps1"
      },
      "pwsh": {
        "cmd": "pwsh -File \"{file}\"",
        "ext": "ps1"
      },
      "bash": {
        "cmd": "bash \"{file}\"",
        "ext": "sh"
      },
      "sh": {
        "cmd": "bash \"{file}\"",
        "ext": "sh"
      },
      "rust": {
        "cmd": "rustc \"{file}\" -o \"{bin}\" && \"{bin}\"",
        "ext": "rs"
      },
      "rs": {
        "cmd": "rustc \"{file}\" -o \"{bin}\" && \"{bin}\"",
        "ext": "rs"
      },
      "go": {
        "cmd": "go run \"{file}\"",
        "ext": "go"
      },
      "golang": {
        "cmd": "go run \"{file}\"",
        "ext": "go"
      },
      "c": {
        "cmd": "gcc \"{file}\" -o \"{bin}\" && \"{bin}\"",
        "ext": "c"
      },
      "cpp": {
        "cmd": "g++ \"{file}\" -o \"{bin}\" && \"{bin}\"",
        "ext": "cpp"
      },
      "c++": {
        "cmd": "g++ \"{file}\" -o \"{bin}\" && \"{bin}\"",
        "ext": "cpp"
      },
      "php": {
        "cmd": "php \"{file}\"",
        "ext": "php"
      },
      "ruby": {
        "cmd": "ruby \"{file}\"",
        "ext": "rb"
      },
      "rb": {
        "cmd": "ruby \"{file}\"",
        "ext": "rb"
      },
      "lua": {
        "cmd": "lua \"{file}\"",
        "ext": "lua"
      },
      "r": {
        "cmd": "Rscript \"{file}\"",
        "ext": "r"
      }
    }
  },
  "functions": [
    {
      "name": "execute_code",
      "description": "Run code on this computer and get its real output and exit code. The language's runtime must be installed. Runs in the open folder with the user's rights.",
      "parameters": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "description": "The programming language to execute (e.g. 'python', 'javascript', 'typescript', 'rust', 'c', 'cpp', 'go', 'bash', 'powershell', 'php', 'ruby', 'lua', 'r')"
          },
          "code": {
            "type": "string",
            "description": "The exact script or code to execute on the host machine"
          },
          "timeout": {
            "type": "integer",
            "description": "Seconds before it is stopped. Default 30"
          }
        },
        "required": [
          "language",
          "code"
        ]
      }
    }
  ],
  "latest_version": "1.0.0",
  "versions": {
    "1.0.0": {
      "updated_at": "2026-11-11T18:25:00Z",
      "files": {
        "readme": "README.md",
        "skill": "SKILL.md",
        "icon": "assets/icon.svg",
        "references": [
          "references/data-analysis-and-charts.md",
          "references/runtimes.md",
          "references/safe-runs.md"
        ]
      }
    }
  },
  "tags": [
    "Code Execution",
    "Scripting"
  ]
}
