{
  "id": "speech",
  "name": "Speech",
  "category": "audio",
  "hub_type": "skill",
  "icon": "assets/icon.svg",
  "description": "Turns an audio file into text and text into a spoken WAV file, with speech models running on this computer. Nothing is sent online. Use to transcribe recordings or read text aloud.",
  "author": {
    "name": "Cluaiz",
    "url": "https://github.com/cluaiz"
  },
  "license": "Apache-2.0",
  "tags": [
    "Audio",
    "Speech",
    "Transcription",
    "Offline"
  ],
  "triggers": {
    "semantic": [
      "transcribe",
      "transcription",
      "speech to text",
      "text to speech",
      "read aloud",
      "voice",
      "audio",
      "wav",
      "mp3",
      "meeting recording",
      "say this",
      "speak",
      "audio to text",
      "voice file",
      "transcribe audio",
      "m4a",
      "flac",
      "ogg"
    ]
  },
  "dependencies": {
    "plugins": {},
    "mcp": {},
    "skills": {}
  },
  "permissions": {
    "files": {
      "info": "Reads the audio file to transcribe, and saves spoken text as a WAV file",
      "allow": false,
      "can": [
        "create",
        "read"
      ],
      "where": "workspace"
    },
    "engine": {
      "info": "Transcribes and speaks through the Engine's audio",
      "allow": true,
      "methods": [
        "audio.run",
        "audio.voices"
      ]
    }
  },
  "functions": [
    {
      "name": "speech",
      "description": "Transcribe an audio file, speak text into a WAV file, or list voices, with local speech models.",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "transcribe",
              "speak",
              "voices"
            ],
            "description": "transcribe, speak or voices"
          },
          "file": {
            "type": "string",
            "description": "transcribe: the audio file"
          },
          "text": {
            "type": "string",
            "description": "speak: the text"
          },
          "output": {
            "type": "string",
            "description": "speak: WAV path (default speech.wav)"
          },
          "voice": {
            "type": "string",
            "description": "speak: voice id such as af_heart or hf_alpha"
          },
          "language": {
            "type": "string",
            "description": "Language code such as en or hi"
          }
        },
        "required": [
          "action"
        ]
      }
    }
  ],
  "execution": {
    "type": "script_runner",
    "scratch_dir": "scratch",
    "default_language": "python",
    "command": "{python} \"{tool_dir}/scripts/speech.py\" \"{file}\""
  },
  "latest_version": "1.0.0",
  "versions": {
    "1.0.0": {
      "updated_at": "2026-11-11T18:30:00Z",
      "files": {
        "readme": "README.md",
        "skill": "SKILL.md",
        "icon": "assets/icon.svg",
        "references": [
          "references/engine-speech-api.md",
          "references/tts-voice-engineering.md"
        ],
        "scripts": [
          "scripts/speech.py"
        ]
      }
    }
  }
}
